<Window x:Class="WpfApp1.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" 
        Width="400" 
        Height="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF1A1A1A"
        BorderBrush="#FF3A3A3A"
        BorderThickness="1">

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="OPTIONS" 
                       FontSize="24" 
                       FontFamily="Segoe UI Light" 
                       Foreground="White"
                       Margin="0,0,0,20"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Music Volume:" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           Width="120"/>
                <Slider x:Name="MusicSlider" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="50"
                        Width="200"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="SFX Volume:" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           Width="120"/>
                <Slider x:Name="SfxSlider" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="70"
                        Width="200"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Fullscreen:" 
                           Foreground="White" 
                           VerticalAlignment="Center"
                           Width="120"/>
                <CheckBox x:Name="FullscreenCheckBox" 
                          IsChecked="True"
                          VerticalAlignment="Center"/>
            </StackPanel>
            
            <Button x:Name="SaveButton" 
                    Content="SAVE" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0"
                    Width="100"
                    Style="{StaticResource MenuButtonStyle}" />
        </StackPanel>
        
        <Button x:Name="CloseButton" 
                Content="✕" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Width="30" 
                Height="30"
                Background="Transparent"
                Foreground="White"
                BorderThickness="0" Style="{StaticResource ButtonStyle}" />
    </Grid>
</Window>