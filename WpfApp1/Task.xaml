<Window x:Class="WpfApp1.Task"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeMbeL Co" Height="600" Width="800">
    <Grid>
            <Canvas x:Name="MainCanvas"/>
            
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#AA000000">
                <Button x:Name="StartButton" Content="Start" Width="100" Margin="0,0,0,5" Foreground="White"/>
                <Button x:Name="StopButton" Content="Stop" Width="100" Margin="0,0,0,5" Foreground="White"/>
                <Button x:Name="ClearButton" Content="Reset" Width="100" Margin="0,0,0,20" Foreground="White"/>
                
                <TextBlock Text="Initial Velocity:" Foreground="White" Margin="0,0,0,5"/>
                <Slider x:Name="VelocitySlider" Minimum="10" Maximum="150" Value="70" 
                        Margin="0,0,0,10" Width="200"/>
                
                <TextBlock Text="Launch Angle:" Foreground="White" Margin="0,0,0,5"/>
                <Slider x:Name="AngleSlider" Minimum="0" Maximum="90" Value="45" 
                        Margin="0,0,0,10" Width="200"/>
                
                <TextBlock Text="Projectile Mass:" Foreground="White" Margin="0,0,0,5"/>
                <Slider x:Name="MassSlider" Minimum="0.1" Maximum="5" Value="1.5" 
                        Margin="0,0,0,10" Width="200"/>
            </StackPanel>
        </Grid>
    </Window>

